<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QRSnip.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QRSnip"
    xmlns:services="using:QRSnip.Services"
    Title="QRSnip capture">

    <local:CursorGrid
        x:Name="Root"
        Background="Black"
        CursorShape="Cross"
        IsTabStop="True"
        KeyDown="OnKeyDown"
        PreviewKeyDown="OnPreviewKeyDown"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        RightTapped="OnRightTapped">

        <!--  Not hit-testable, so the pointer is always over Root and its crosshair (#1).  -->
        <Image x:Name="Shot" IsHitTestVisible="False" Stretch="Fill" />

        <!--  Everything outside the selection is dimmed.  -->
        <Grid x:Name="Dim" IsHitTestVisible="False" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DimTop" Height="0" />
                <RowDefinition x:Name="DimMiddle" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DimLeft" Width="0" />
                <ColumnDefinition x:Name="DimCenter" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="3" Fill="#80000000" />
            <Rectangle Grid.Row="1" Fill="#80000000" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="#80000000" />
            <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="#80000000" />
        </Grid>

        <Canvas x:Name="Layer">
            <!--  Full screen mode: an outline and a numbered chip for each code found.  -->
            <Canvas x:Name="Marks" />

            <Border x:Name="Selection" BorderBrush="White" BorderThickness="2" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#66000000" BorderThickness="1" CornerRadius="1" />
            </Border>

            <Border x:Name="SizeTag" Padding="6,2" Background="#CC1F1F1F" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" FontSize="11" Foreground="White" />
            </Border>

            <!--  Hint bar. Codes anywhere on screen are found automatically; dragging scans an area.  -->
            <Border
                x:Name="Hint"
                Padding="16,10"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="22"
                PointerPressed="OnChromePointerPressed">
                <local:CursorGrid CursorShape="Arrow">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="HintIcon" FontSize="16" Glyph="&#xED14;" />
                        <TextBlock x:Name="HintText" VerticalAlignment="Center" Text="Drag around a QR code" />
                        <TextBlock x:Name="HintSecondary" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Click for whole screen · Esc to cancel" />
                    </StackPanel>
                </local:CursorGrid>
            </Border>

            <Border
                x:Name="Card"
                Width="380"
                Padding="0"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                PointerPressed="OnChromePointerPressed"
                Visibility="Collapsed">
                <local:CursorGrid CursorShape="Arrow">
                <StackPanel>
                    <ItemsControl x:Name="Results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:HistoryEntry">
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <local:ResultCard ActionInvoked="OnResultAction" Entry="{x:Bind}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Padding="16,8,8,8">
                        <TextBlock x:Name="CardStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Drag again to scan another area" />
                        <Button HorizontalAlignment="Right" Click="OnDoneClick" Content="Done" Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                </StackPanel>
                </local:CursorGrid>
            </Border>
        </Canvas>
    </local:CursorGrid>
</Window>
