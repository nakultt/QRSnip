<?xml version="1.0" encoding="utf-8"?>
<!--  One decoded code with its actions. Shared by the capture overlay, pictures and the camera.  -->
<UserControl
    x:Class="QRSnip.ResultCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="16,14,16,16" Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Style="{StaticResource IconBadgeStyle}">
                <FontIcon x:Name="KindIcon" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="KindText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="TitleText" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <Border Padding="10,8" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
            <TextBlock x:Name="PayloadText" FontFamily="Cascadia Mono,Consolas" FontSize="12" IsTextSelectionEnabled="True" MaxLines="5" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenButton" Click="OnOpenClick" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    <TextBlock x:Name="OpenText" />
                </StackPanel>
            </Button>
            <Button x:Name="SecretButton" Click="OnCopySecretClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                    <TextBlock Text="Copy password" />
                </StackPanel>
            </Button>
            <Button Click="OnCopyClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    <TextBlock Text="Copy" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
