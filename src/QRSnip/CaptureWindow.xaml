<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QRSnip.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QRSnip"
    xmlns:services="using:QRSnip.Services"
    Title="QRSnip capture">

    <local:CursorGrid
        x:Name="Root"
        Background="Black"
        CursorShape="Cross"
        IsTabStop="True"
        KeyDown="OnKeyDown"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        RightTapped="OnRightTapped">

        <Image x:Name="Shot" Stretch="Fill" />

        <!--  Everything outside the selection is dimmed.  -->
        <Grid x:Name="Dim" IsHitTestVisible="False" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DimTop" Height="0" />
                <RowDefinition x:Name="DimMiddle" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DimLeft" Width="0" />
                <ColumnDefinition x:Name="DimCenter" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="3" Fill="#80000000" />
            <Rectangle Grid.Row="1" Fill="#80000000" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="#80000000" />
            <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Fill="#80000000" />
        </Grid>

        <Canvas x:Name="Layer">
            <Border x:Name="Selection" BorderBrush="White" BorderThickness="2" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#66000000" BorderThickness="1" CornerRadius="1" />
            </Border>

            <Border x:Name="SizeTag" Padding="6,2" Background="#CC1F1F1F" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" FontSize="11" Foreground="White" />
            </Border>

            <Border x:Name="Hint" Padding="16,10" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" CornerRadius="20" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="HintIcon" FontSize="16" Glyph="&#xED14;" />
                    <TextBlock x:Name="HintText" VerticalAlignment="Center" Text="Drag around a QR code" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Click for whole screen · Esc to cancel" />
                </StackPanel>
            </Border>

            <Border
                x:Name="Card"
                Width="380"
                Padding="0"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                PointerPressed="OnCardPointerPressed"
                Visibility="Collapsed">
                <local:CursorGrid CursorShape="Arrow">
                <StackPanel>
                    <ItemsControl x:Name="Results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:HistoryEntry">
                                <StackPanel Padding="16,14,16,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Style="{StaticResource IconBadgeStyle}">
                                            <FontIcon FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="{x:Bind Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind KindLabel}" />
                                            <TextBlock MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Content.Title}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Padding="10,8" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" IsTextSelectionEnabled="True" MaxLines="5" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnOpenClick" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind CanOpen}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                                <TextBlock Text="{x:Bind OpenLabel}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnCopySecretClick" Visibility="{x:Bind HasSecret}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                                <TextBlock Text="Copy password" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnCopyClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                <TextBlock Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Padding="16,8,8,8">
                        <TextBlock x:Name="CardStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Drag again to scan another area" />
                        <Button HorizontalAlignment="Right" Click="OnDoneClick" Content="Done" Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                </StackPanel>
                </local:CursorGrid>
            </Border>
        </Canvas>
    </local:CursorGrid>
</Window>
