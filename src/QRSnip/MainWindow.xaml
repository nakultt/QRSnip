<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QRSnip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QRSnip"
    xmlns:services="using:QRSnip.Services"
    Title="QRSnip">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="Transparent"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <!--  Paste a picture, e.g. right after Win+Shift+S.  -->
            <KeyboardAccelerator Invoked="OnPasteInvoked" Key="V" Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Wide or maximized window: scan panel on the left, recent scans on the right (MainWindow.ApplyLayout).  -->

        <!--  Title bar  -->
        <TitleBar x:Name="AppTitleBar" Title="QRSnip" BackRequested="OnBackRequested" IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Update available (shown above the home page and Settings)  -->
        <InfoBar
            x:Name="UpdateBar"
            Grid.Row="1"
            Margin="20,0,20,8"
            IsOpen="False"
            Severity="Informational"
            Title="Update available">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateButton" Click="OnInstallUpdateClick" Content="Restart to update" Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Spacing="8">
                    <TextBlock x:Name="UpdateNotes" MaxLines="6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!--  Home  -->
        <Grid x:Name="HomePage" Grid.Row="2" Padding="20,4,20,12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ScanCard" VerticalAlignment="Top" Style="{StaticResource CardStyle}" Padding="24,28">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Border Width="64" Height="64" Margin="0,0,0,10" HorizontalAlignment="Center" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon FontSize="30" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xED14;" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Scan a QR code" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Drag a box around any code on your screen, or open, drop or paste a picture." TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ScanButton" Padding="20,8" Click="OnScanClick" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xF406;" />
                                <TextBlock Text="New scan" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenPictureButton" Padding="12,8" AutomationProperties.Name="Open picture" Click="OnOpenPictureClick" ToolTipService.ToolTip="Scan a picture file. You can also drop pictures here or paste one with Ctrl+V.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B9;" />
                                <TextBlock Text="Picture" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CameraButton" Padding="12,8" AutomationProperties.Name="Scan with camera" Click="OnCameraClick" ToolTipService.ToolTip="Scan a printed code or a phone screen with your webcam.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE722;" />
                                <TextBlock Text="Camera" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="HotkeyHint" Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                </StackPanel>
            </Border>

            <Grid x:Name="RecentHeader" Grid.Row="1" Margin="4,8,0,0">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <HyperlinkButton x:Name="ClearButton" Padding="8,4" Click="OnClearClick" Content="Clear all" />
                </StackPanel>
            </Grid>

            <ListView
                x:Name="HistoryList"
                Grid.Row="2"
                Margin="-4,0"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:HistoryEntry">
                        <Grid Padding="12,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ColumnSpacing="12" CornerRadius="{StaticResource ControlCornerRadius}" ToolTipService.ToolTip="{x:Bind Subtitle}">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnOpenClick" Text="{x:Bind OpenLabel}" Visibility="{x:Bind CanOpen}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnCopyClick" Text="Copy">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnCopySecretClick" Text="Copy password" Visibility="{x:Bind HasSecret}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8D7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnDeleteClick" Text="Remove">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border VerticalAlignment="Center" Style="{StaticResource IconBadgeStyle}">
                                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Content.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind When}" />
                                <Button Width="32" Height="32" Padding="0" Click="OnOpenClick" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{x:Bind OpenLabel}" Visibility="{x:Bind CanOpen}">
                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                </Button>
                                <Button Width="32" Height="32" Padding="0" Click="OnCopyClick" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Copy">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Grid.Row="2" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="6">
                <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE81C;" />
                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Codes you scan will show up here." />
            </StackPanel>

            <Button x:Name="SettingsButton" Grid.Row="3" Padding="10,6" AutomationProperties.Name="Settings" Click="OnSettingsClick" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>

        </Grid>

        <!--  Pictures that were opened, dropped or pasted  -->
        <local:PictureView x:Name="PicturePage" Grid.Row="2" Visibility="Collapsed" />

        <!--  Webcam scanning  -->
        <local:CameraView x:Name="CameraPage" Grid.Row="2" Visibility="Collapsed" />

        <!--  Settings  -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
            <StackPanel MaxWidth="760" Padding="20,4,20,20" Spacing="4">
                <TextBlock Margin="4,0,0,12" Style="{StaticResource SubtitleTextBlockStyle}" Text="Settings" />

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Scan shortcut" />
                        <TextBlock x:Name="HotkeyDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Starts a scan from anywhere, like Print Screen for Snipping Tool." TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="HotkeyCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnHotkeyChanged" />
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Copy results automatically" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Put the decoded text on the clipboard as soon as a code is found." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoCopyToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="OnSettingToggled" />
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keep running in the background" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Closing the window keeps QRSnip in the notification area so the shortcut works anywhere." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="BackgroundToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="OnSettingToggled" />
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clicking the notification area icon" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="What a left-click on QRSnip's icon does. Right-click always opens the menu." TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="TrayClickCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnTrayClickChanged">
                        <ComboBoxItem Content="Opens QRSnip" />
                        <ComboBoxItem Content="Starts a scan" />
                    </ComboBox>
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock x:Name="StartupDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Start quietly in the notification area when you sign in." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="OnStartupToggled" />
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save scan history" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Stored only on this device. Turning it off clears it." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HistoryToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="OnSettingToggled" />
                </Grid>

                <TextBlock Margin="4,20,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" VerticalAlignment="Center" Source="ms-appx:///Assets/AppLogo.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="QRSnip" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Updates" />
                        <TextBlock x:Name="UpdateStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="See if a newer version of QRSnip is available." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" />
                        <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClick" Content="Check for updates" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Automatically check for updates" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="At most once a day and never during a scan. Only asks GitHub or the Microsoft Store for the latest version." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="OnSettingToggled" />
                </Grid>

                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Quit QRSnip" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Stops QRSnip completely, including the shortcut and the notification area icon." TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="96" VerticalAlignment="Center" Click="OnQuitClick" Content="Quit" />
                </Grid>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton Content="Source code" NavigateUri="https://github.com/nakultt/QRSnip" />
                    <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/nakultt/QRSnip/issues" />
                    <HyperlinkButton Content="Privacy" NavigateUri="https://github.com/nakultt/QRSnip/blob/main/PRIVACY.md" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Shown while pictures are dragged over the window.  -->
        <Border
            x:Name="DropZone"
            Grid.Row="1"
            Grid.RowSpan="2"
            Margin="12"
            Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0.94"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon HorizontalAlignment="Center" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B9;" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Drop to scan" />
                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="QRSnip reads every code in the pictures." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
